# Exclude everything
*
!.gitignore
!db_utils.py
!README.md
!train_yuel_design.py
!yuel_design.py
!LICENSE

# Don't exclude the src and data/MOAD directories
!src/
!data/
!data/MOAD/
!scripts/

# Include Python files in src and its subdirectories
src/*
!src/
!src/*.py
!src/**/
!src/**/*.py

# Include Python files in data and its subdirectories, and README.md in data/MOAD
data/*
!data/*.py
!data/**/
!data/**/*.py
!data/MOAD/README.md

# Include scripts directory but exclude .sh files
scripts/*
!scripts/*.py
scripts/*.sh

# Ignore non-MOAD datasets while keeping them locally
data/casf/
data/geom/
data/geom_moad/
data/zinc/

# Exclude Python cache files
__pycache__/
*.py[cod]
*$py.class

# Exclude virtual environment
venv/
env/
.env/

# Exclude IDE files
.vscode/
.idea/
*.swp
*.swo

# Exclude common data and model files
*.pkl
*.ckpt
*.sdf
*.pdb
*.mol
*.xyz
*.csv
*.txt

# Override exclusions for specific files
!2req_0.mol
!2req_pocket.pdb
!2req_protein.pdb
